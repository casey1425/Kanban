<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kanban.App.ViewModels"
             x:Class="Kanban.App.Views.CardDetailView"
             x:DataType="vm:CardDetailViewModel">

    <UserControl.Styles>
        <!-- 라벨 칩: 선택 안 된 상태는 흐리게 -->
        <Style Selector="Button.chip">
            <Setter Property="Opacity" Value="0.35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style Selector="Button.chip.selected">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Border Width="460" Padding="20" CornerRadius="10"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <Grid RowDefinitions="*,Auto" RowSpacing="12">
        <ScrollViewer MaxHeight="500">
        <StackPanel Spacing="14" Margin="0,0,12,0">
            <TextBox Text="{Binding Card.Title}" FontSize="18" FontWeight="SemiBold"/>

            <StackPanel Spacing="4">
                <TextBlock Text="설명" Opacity="0.7"/>
                <TextBox Text="{Binding Card.Description}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="90" MaxHeight="200"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="마감일" Opacity="0.7"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CalendarDatePicker SelectedDate="{Binding Card.DueDateTime}"/>
                    <Button Content="지우기" Command="{Binding ClearDueDateCommand}"
                            IsVisible="{Binding Card.HasDueDate}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="라벨" Opacity="0.7"/>
                <ItemsControl ItemsSource="{Binding Card.LabelOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LabelOptionViewModel">
                            <Button Classes="chip" Classes.selected="{Binding IsSelected}"
                                    Background="{Binding Color}"
                                    Content="{Binding Name}"
                                    Command="{Binding ToggleCommand}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="체크리스트" Opacity="0.7"/>
                    <TextBlock Text="{Binding Card.ChecklistSummary}"
                               IsVisible="{Binding Card.HasChecklist}" Opacity="0.7"/>
                </StackPanel>

                <ProgressBar Minimum="0" Height="6"
                             Maximum="{Binding Card.ChecklistTotalCount}"
                             Value="{Binding Card.ChecklistDoneCount}"
                             IsVisible="{Binding Card.HasChecklist}"/>

                <ItemsControl ItemsSource="{Binding Card.Checklist}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChecklistItemViewModel">
                            <Grid ColumnDefinitions="*,Auto">
                                <CheckBox Grid.Column="0" Content="{Binding Text}"
                                          IsChecked="{Binding IsDone}"
                                          Command="{Binding ToggleCommand}"/>
                                <Button Grid.Column="1" Content="✕" Padding="6,2"
                                        VerticalAlignment="Center"
                                        Command="{Binding DeleteCommand}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Grid.Column="0" PlaceholderText="항목 추가"
                             Text="{Binding Card.NewChecklistText}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding Card.AddChecklistItemCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="추가" Command="{Binding Card.AddChecklistItemCommand}"/>
                </Grid>
            </StackPanel>

        </StackPanel>
        </ScrollViewer>

        <!-- 닫기는 스크롤 영역 밖에 고정해서, 내용이 길어도 항상 보이게 한다 -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
            <!-- 패널이 열려 있는 동안 라벨/체크리스트 변경을 되돌린다(Ctrl+Z 와 같은 명령) -->
            <Button Grid.Column="0" Content="실행 취소" Command="{Binding UndoCommand}"/>
            <Button Grid.Column="1" Content="다시 실행" Command="{Binding RedoCommand}"/>
            <Button Grid.Column="3" Content="닫기" Command="{Binding CloseCommand}"/>
        </Grid>
        </Grid>
    </Border>
</UserControl>
