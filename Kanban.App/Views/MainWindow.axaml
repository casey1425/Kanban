<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kanban.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="Kanban.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1000" Height="600"
        Title="Kanban">

    <Grid>
    <DockPanel>
        <!-- 상단 바: 제목 + 리스트 추가 / 검색 + 라벨 필터 -->
        <Border DockPanel.Dock="Top" Padding="16,12"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" Text="{Binding BoardTitle}" FontSize="20"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="{Binding ThemeLabel}"
                            Command="{Binding CycleThemeCommand}" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="2" Width="200" PlaceholderText="새 리스트 이름"
                             Text="{Binding NewListName}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding AddNewListCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="3" Content="리스트 추가" Command="{Binding AddNewListCommand}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox Width="260" PlaceholderText="카드 검색 (제목, 설명, 체크리스트)"
                             Text="{Binding SearchText}"/>
                    <ComboBox Width="150" ItemsSource="{Binding LabelFilters}"
                              SelectedItem="{Binding SelectedLabelFilter}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LabelFilterOption">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="필터 초기화" Command="{Binding ClearFilterCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 불러오기/저장 실패 안내 -->
        <Border DockPanel.Dock="Top" Padding="16,8" Background="#C42B1C"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="White"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="닫기" Command="{Binding DismissErrorCommand}"/>
            </Grid>
        </Border>

        <!-- 리스트들을 가로로 나열. 각 항목은 ViewLocator가 BoardListView로 그린다 -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Lists}" Margin="12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>

    <!-- 카드 상세 패널: Detail이 있을 때만 보인다. 배경을 누르면 닫힌다. -->
    <Grid IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Border Background="#99000000" PointerPressed="OnBackdropPressed"/>
        <ContentControl Content="{Binding Detail}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    </Grid>
</Window>
