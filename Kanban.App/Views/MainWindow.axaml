<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kanban.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
        x:Class="Kanban.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1200" Height="720"
        Title="Kanban">

    <Window.Styles>
        <!--
            카드를 끌어 보드 위에 올렸을 때의 강조(코드비하인드가 drop-target 클래스를 붙인다).
            테두리(BorderThickness)는 행 크기를 바꿔 목록이 흔들리므로, 크기에 영향이 없는 안쪽 그림자로 테두리를 그린다.
        -->
        <Style Selector="ListBox#BoardList ListBoxItem.drop-target /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.35"/>
            </Setter>
            <Setter Property="BoxShadow" Value="inset 0 0 0 2 #2563EB"/>
        </Style>
    </Window.Styles>

    <Grid>
        <DockPanel>
            <!-- 왼쪽 사이드바: 보드 목록 -->
            <Border DockPanel.Dock="Left" Width="220" Padding="12"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Bottom" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                            Content="{Binding ThemeLabel}" Command="{Binding CycleThemeCommand}"/>

                    <!-- 새 보드 -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
                        <TextBox PlaceholderText="새 보드 이름" Text="{Binding NewBoardName}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding AddNewBoardCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Content="보드 추가" HorizontalAlignment="Stretch"
                                Command="{Binding AddNewBoardCommand}"/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="보드" FontWeight="SemiBold"
                               Opacity="0.7" Margin="4,0,0,6"/>

                    <!-- 카드를 이 목록의 보드 위로 끌어다 놓으면 그 보드로 옮긴다 -->
                    <ListBox x:Name="BoardList" DragDrop.AllowDrop="True"
                             ItemsSource="{Binding Boards}" SelectedItem="{Binding SelectedBoard}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:BoardViewModel">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 불러오기/저장 실패 안내 -->
            <Border DockPanel.Dock="Top" Padding="16,8" Background="#C42B1C"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="White"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="닫기" Command="{Binding DismissErrorCommand}"/>
                </Grid>
            </Border>

            <!-- 작업 결과 안내 (예: 카드를 다른 보드로 옮김) -->
            <Border DockPanel.Dock="Top" Padding="16,8" Background="#2563EB"
                    IsVisible="{Binding InfoMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="{Binding InfoMessage}" Foreground="White"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="닫기" Command="{Binding DismissInfoCommand}"/>
                </Grid>
            </Border>

            <!-- 선택한 보드. BoardViewModel은 ViewLocator가 BoardView로 그린다 -->
            <ContentControl Content="{Binding SelectedBoard}"/>
        </DockPanel>

        <!-- 카드 상세 패널: Detail이 있을 때만 보인다. 배경을 누르면 닫힌다. -->
        <Grid IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Border Background="#99000000" PointerPressed="OnBackdropPressed"/>
            <ContentControl Content="{Binding Detail}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
