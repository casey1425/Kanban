<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kanban.App.ViewModels"
             x:Class="Kanban.App.Views.BoardListView"
             x:DataType="vm:BoardListViewModel">

    <Border Width="280" Padding="10" CornerRadius="8"
            VerticalAlignment="Top"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <StackPanel Spacing="8">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,0"/>

            <!-- ItemTemplate을 지정하지 않으면 ViewLocator가 CardViewModel -> CardView로 연결한다 -->
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- 새 카드 입력: Enter 키 또는 버튼으로 추가 -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0" PlaceholderText="새 카드 제목"
                         Text="{Binding NewCardTitle}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AddNewCardCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Content="추가" Command="{Binding AddNewCardCommand}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
